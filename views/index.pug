extends layout

block content
  section.home
    h1 Welcome to Kolab
    p Manage your projects, tasks, and teams in one place.
    if !user
      p To get started, please log in or register.
      div.buttons
        a(href="/login" class="btn btn-primary") Login
        a(href="/register" class="btn btn-secondary") Register
    else
      p Welcome back, #{user.username}! You can start managing your projects.
